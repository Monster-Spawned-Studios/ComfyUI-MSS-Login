# mss_login / ComfyUI-MSS-Login: environment variables for sensitive config.
# Copy to .env and set values. Never commit .env or .env.keys.
# For encrypted storage: run `dotenvx encrypt` in this folder to store
# SECRET_KEY (and other secrets) encrypted in .env; keep .env.keys out of source control.
# In production, set DOTENV_PRIVATE_KEY in the environment instead of deploying .env.keys.

# JWT signing secret (required for stable sessions)
SECRET_KEY=

# API token store: SQLite path (optional; default is cross-platform user data dir)
SQLITE_PATH=
API_TOKEN_SQLITE_PATH=

# API token store: PostgreSQL (optional)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
API_TOKEN_DB_PASSWORD=

# Recovery mode: allow POST /api/mss_login/recovery/reset-mfa from allowed hosts only (default: 127.0.0.1, ::1)
RECOVERY_MODE=false
RECOVERY_MODE_HOST=127.0.0.1,::1
