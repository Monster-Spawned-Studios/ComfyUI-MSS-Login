# mss_login / ComfyUI-MSS-Login: environment variables for sensitive config.
# Copy to .env and set values. Never commit .env or .env.keys.
# For encrypted storage: run `dotenvx encrypt` in this folder to store
# SECRET_KEY (and other secrets) encrypted in .env; keep .env.keys out of source control.
# In production, set DOTENV_PRIVATE_KEY in the environment instead of deploying .env.keys.

# JWT signing secret (required for stable sessions). Also used to derive SQLite encryption key when encryption_level is set.
SECRET_KEY=CHANGE_ME

# External data directory: config, DB, and runtime data live here (untouched by git pull / ComfyUI Manager).
# Default: ~/.comfyui-mss-login . Override to use a different path.
# MSS_LOGIN_DATA_DIR=/path/to/your/data

# Unified database (users, API tokens, shared items): one SQLite file or one Postgres DB.
# SQLite path (optional; default: data/users.db under the data directory above)
USERS_DB_SQLITE_PATH=data/users.db
USERS_DB_PASSWORD=CHANGE_ME

# PostgreSQL (optional). Password from env only; set POSTGRES_PASSWORD or USERS_DB_PASSWORD.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=mss_login
POSTGRES_USER=mss_login
POSTGRES_PASSWORD=CHANGE_ME

# For encrypted SQLite: set encryption_level in config.json users_db to low|standard|secure.
# Requires pysqlcipher3 and argon2-cffi (see README).

# Recovery mode: allow POST /api/mss-login/recovery/reset-mfa from allowed hosts only (default: 127.0.0.1, ::1)
RECOVERY_MODE=false
RECOVERY_MODE_HOST=127.0.0.1,::1

# Whether or not to enable DEBUG_MODE
#!!! ONLY ENABLE THIS IN DEVELOPMENT ENVIRONMENTS, OR TO TROUBLESHOOT ISSUES !!!
DEBUG_MODE=false