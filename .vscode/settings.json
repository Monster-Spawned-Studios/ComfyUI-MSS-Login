{
    "python.venvPath": ".venv",
    "git.ignoreLimitWarning": true,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "always"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.autopep8",
        "editor.formatOnSave": true,
        "editor.formatOnPaste": true
    },
    "snyk.features.codeSecurity": true,
    "snyk.features.openSourceSecurity": true,
    "snyk.scanningMode": "manual",
    "snyk.securityAtInception.autoConfigureSnykMcpServer": true,
    "snyk.advanced.autoSelectOrganization": false,
    "snyk.advanced.organization": "monster-spawned-studios`",
}