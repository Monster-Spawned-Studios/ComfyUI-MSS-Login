{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "comfyuiPath",
      "type": "promptString",
      "description": "Manual path to the testing ComfyUI instance (folder with main.py, or where one should be created).",
      "default": "${workspaceFolder}/ComfyUI"
    },
    {
      "id": "autoInstallComfyUI",
      "type": "pickString",
      "description": "If that path does not exist / has no main.py, automatically generate a ComfyUI server? (toggle)",
      "options": ["yes", "no"],
      "default": "yes"
    },
    {
      "id": "comfyInstallFlavor",
      "type": "pickString",
      "description": "Install flavor when auto-generating ComfyUI",
      "options": ["cpu", "nvidia", "amd", "m-series"],
      "default": "cpu"
    }
  ],
  "tasks": [
    {
      "label": "Prepare ComfyUI for MSS-Login",
      "detail": "Uses .vscode/comfyui-test.local.json (path + autoInstall toggle). Run 'Configure ComfyUI test instance' first if missing.",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "${workspaceFolder}/.vscode/scripts/ensure_comfyui.py",
        "--mss-src",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT": "${workspaceFolder}",
          "MSS_LOGIN_SRC": "${workspaceFolder}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "group": "build"
    },
    {
      "label": "Configure ComfyUI test instance",
      "detail": "Prompt for ComfyUI path and auto-install toggle; save to comfyui-test.local.json",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "${workspaceFolder}/.vscode/scripts/ensure_comfyui.py",
        "--write-settings-only",
        "--path",
        "${input:comfyuiPath}",
        "--auto-install",
        "${input:autoInstallComfyUI}",
        "--flavor",
        "${input:comfyInstallFlavor}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "group": "build"
    },
    {
      "label": "Prepare ComfyUI (prompt path each time)",
      "detail": "One-off: ask for path + auto-install toggle, then prepare (also updates local settings)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "args": [
        "${workspaceFolder}/.vscode/scripts/ensure_comfyui.py",
        "--path",
        "${input:comfyuiPath}",
        "--auto-install",
        "${input:autoInstallComfyUI}",
        "--flavor",
        "${input:comfyInstallFlavor}",
        "--mss-src",
        "${workspaceFolder}",
        "--save-settings"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "UV_PROJECT": "${workspaceFolder}",
          "MSS_LOGIN_SRC": "${workspaceFolder}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "group": "build"
    },
    {
      "label": "Install comfy-cli (uv group)",
      "type": "shell",
      "command": "uv",
      "args": ["sync", "--group", "comfyui"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "UV_PROJECT": "${workspaceFolder}" }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" },
      "group": "build"
    },
    {
      "label": "Copy MSS-Login to ComfyUI",
      "type": "shell",
      "command": "rsync",
      "args": [
        "-a",
        "--del",
        "--exclude=.git",
        "--exclude=.env",
        "--exclude=.env.keys",
        "--exclude=.venv",
        "--exclude=__pycache__",
        "--exclude=*.log",
        "--exclude=logs",
        "--exclude=.vscode",
        "--exclude=.agent",
        "--exclude=docs",
        "--exclude=readme",
        "--exclude=.github",
        "--exclude=users/.ephemeral_secret_key",
        "${workspaceFolder}/",
        "/Volumes/Mando Drive/ComfyUI/custom_nodes/ComfyUI-MSS-Login/"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" },
      "group": "build"
    },
    {
      "label": "Deploy and Launch ComfyUI",
      "dependsOrder": "sequence",
      "dependsOn": ["Copy MSS-Login to ComfyUI"],
      "type": "shell",
      "command": "comfy",
      "args": ["--workspace", "/Volumes/Mando Drive/ComfyUI", "launch"],
      "options": {
        "cwd": "/Volumes/Mando Drive/ComfyUI",
        "env": {
          "DEBUG_MODE": "true",
          "SECRET_KEY": "CHANGE_ME_TO_A_REAL_SECRET_KEY",
          "RECOVERY_MODE": "false",
          "RECOVERY_MODE_HOST": "127.0.0.1,::1",
          "USERS_DB_SQLITE_PATH": "users/users.db"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
