{
  "version": "0.2",
  "enabled": true,
  "words": [],
  "useGitignore": true,
  "allowCompoundWords": false,
  "ignoreRandomStrings": true,
  "caseSensitive": false,
  "description": "Spell check for the MSS-Login ComfyUI node project.",
  "engines": {
    "node": ">=22.0.0"
  },
  "minWordLength": 4,
  "ignorePaths": [
    ".git",
    ".github",
    ".gitea",
    ".vscode",
    ".cursor",
    ".venv",
    "**/__pycache__/**",
    "**/node_modules/**",
    ".pnpm-store/**",
    ".ruff_cache/**",
    "_planning/**",
    "tests",
    "tests/**",
    "web/dist/**",
    "web/frontend/**",
    "web/vendor/**",
    "*.lock",
    "pnpm-lock.yaml",
    "uv.lock"
  ],
  "dictionaries": [
    "en-GB",
    "en_US",
    "python",
    "javascript",
    "json",
    "software-terms",
    "mss-login",
    "comfyui",
    "monsterspawnedstudios"
  ],
  "dictionaryDefinitions": [
    {
      "name": "mss-login",
      "path": "./dictionaries/mss-login.txt"
    },
    {
      "name": "comfyui",
      "path": "./dictionaries/comfyui.txt"
    },
    {
      "name": "monsterspawnedstudios",
      "path": "./dictionaries/monsterspawnedstudios.txt"
    }
  ],
  "maxDuplicateProblems": 5,
  "maxNumberOfProblems": 250,
  "suggestionNumChanges": 3,
  "numSuggestions": 10,
  "minRandomLength": 5,
  "files": ["**/*"]
}
